{
  "name": "mestolo",
  "version": "0.1.0",
  "private": true,
  "description": "Mestolo – ricettario intelligente, web app responsive multiutente",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db":"vitest run --config vitest.db.config.ts",
    "db:test:local": "bash scripts/test-db-local.sh",
    "seed:catalog": "node --experimental-strip-types scripts/seed-catalog.ts",
    "gen:key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "mobile:sync": "node scripts/mobile-prepare.mjs && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "mobile:assets": "capacitor-assets generate --android --ios --iconBackgroundColor \"#2a1a2e\" --iconBackgroundColorDark \"#2a1a2e\" --splashBackgroundColor \"#2a1a2e\" --splashBackgroundColorDark \"#2a1a2e\"",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@sentry/nextjs": "11.8.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "cheerio": "1.2.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "pg": "8.23.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "type": "module"
}
