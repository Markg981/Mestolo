{
  "name": "mestolo",
  "version": "1.0.0",
  "private": true,
  "description": "Mestolo – ricettario intelligente, web app responsive multiutente",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "predev": "node scripts/copy-ocr-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-ocr-assets.mjs && node scripts/check-legal.mjs",
    "check:legal": "node scripts/check-legal.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --exclude tests/unit/import-html.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:test:local": "bash scripts/test-db-local.sh",
    "seed:catalog": "node --experimental-strip-types scripts/seed-catalog.ts",
    "gen:key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "mobile:sync": "node scripts/mobile-prepare.mjs && node scripts/mobile-version.mjs && cap sync",
    "mobile:version": "node scripts/mobile-version.mjs",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "mobile:assets": "capacitor-assets generate --android --ios --iconBackgroundColor \"#2a1a2e\" --iconBackgroundColorDark \"#2a1a2e\" --splashBackgroundColor \"#2a1a2e\" --splashBackgroundColorDark \"#2a1a2e\"",
    "icons": "node scripts/generate-icons.mjs",
    "store:screenshots": "node scripts/store-screenshots.mjs",
    "store:graphic": "node scripts/store-feature-graphic.mjs"
  },
  "dependencies": {
    "@capacitor-mlkit/text-recognition": "^8.2.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@sentry/nextjs": "11.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "@tesseract.js-data/ita": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "cheerio": "1.2.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^6.1.2",
    "undici": "8.12.3",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "pg": "8.23.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@capacitor/assets": {
      "sharp": "$sharp",
      "tar": "^7.5.22"
    }
  },
  "type": "module"
}
