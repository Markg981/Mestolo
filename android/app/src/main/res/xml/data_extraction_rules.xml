<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nessun dato dell'app nel backup cloud né nel trasferimento da dispositivo a dispositivo
     (token di sessione Supabase e preferenze non devono uscire dal dispositivo). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
