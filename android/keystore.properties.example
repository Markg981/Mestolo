# Copy to android/keystore.properties (gitignored) to sign release builds locally.
# In CI the same values come from env vars: ANDROID_KEYSTORE_PATH, ANDROID_KEYSTORE_PASSWORD,
# ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD. Without them the release build stays unsigned.
storeFile=C:/path/to/mestolo-upload.jks
storePassword=change-me
keyAlias=upload
keyPassword=change-me
