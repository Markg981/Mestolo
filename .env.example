# =====================================================================
# Mestolo – variabili d'ambiente (copia in .env.local; NON committare i valori)
# =====================================================================

# --- Supabase (obbligatorie) -----------------------------------------
# Dashboard Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo lato server. Serve per: chiavi API cifrate, quote AI, cache traduzioni,
# rate limiting, eliminazione account. Non esporla mai al browser.
SUPABASE_SERVICE_ROLE_KEY=

# URL pubblico dell'app (link nelle email di conferma/recupero password)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contatto di supporto mostrato in app (obbligatorio per App Store / Google Play)
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Cifratura delle API key personali (obbligatoria per le chiavi utente)
# 32 byte in base64. Genera con: npm run gen:key (obbligatoria in produzione: fail-fast all'avvio)
# Conservala separatamente dal database (es. variabili d'ambiente di Vercel).
APP_ENCRYPTION_KEY=
# Opzionale, solo durante la rotazione: la chiave precedente (fallback in decifratura).
APP_ENCRYPTION_KEY_PREVIOUS=

# --- Servizio AI "base" pagato dal gestore (facoltativo) ---------------
# Lascia vuoto per disattivare: gli utenti potranno usare solo la propria chiave.
# Provider: anthropic | openai | openai-compatible
AI_APP_PROVIDER=
AI_APP_API_KEY=
# Solo per openai-compatible (es. Ollama, OpenRouter, Mistral, Groq):
AI_APP_BASE_URL=
# Modelli (facoltativi: hanno valori predefiniti, vedi docs/ai-providers.md)
AI_APP_TEXT_MODEL=
AI_APP_VISION_MODEL=
# Generazione immagini con la chiave del gestore: solo provider openai
AI_APP_IMAGE_ENABLED=false
AI_APP_IMAGE_MODEL=

# Import da video caricato: trascrizione audio (OpenAI /audio/transcriptions; anche per chiavi
# personali OpenAI e per provider openai-compatible che la espongono, es. Groq). Conta come quota 'text'.
AI_TRANSCRIBE_MODEL=whisper-1

# Quote giornaliere per utente sul servizio base (le chiavi personali non hanno quota app)
AI_DAILY_LIMIT_TEXT=20
AI_DAILY_LIMIT_VISION=10
AI_DAILY_LIMIT_IMAGE=2
AI_DAILY_LIMIT_TRANSLATE=30

# Modelli predefiniti usati con le chiavi personali degli utenti
AI_USER_ANTHROPIC_MODEL=claude-sonnet-5-5
AI_USER_OPENAI_TEXT_MODEL=gpt-5-mini
AI_USER_OPENAI_IMAGE_MODEL=gpt-image-1

# --- App mobile (Capacitor) – usate da `npm run mobile:sync` -----------
# Indirizzo HTTPS pubblico del sito che l'app carica
# Obbligatorio, nessun default (un segnaposto example.com viene rifiutato). Solo sviluppo: CAP_DEV=1 usa http://localhost:3000
#CAP_SERVER_URL=https://tuo-dominio
# Identificativo univoco dell'app sugli store
CAP_APP_ID=com.markg981.mestolo

# --- Monitoraggio errori (Sentry) - opzionale, senza DSN e disattivato --
# NEXT_PUBLIC_SENTRY_DSN abilita anche il browser (e il CSP); SENTRY_DSN solo server/edge
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Frazione di richieste tracciate (0-1, default 0.05)
SENTRY_TRACES_SAMPLE_RATE=0.05
# Solo in build, per caricare le source map (facoltativo)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Pulizia programmata (Vercel Cron) ---
# Obbligatorio in produzione (min 16 caratteri): se manca o e' corto l'app non parte (errore di configurazione). Segreto per /api/cron: Vercel lo invia come Bearer. Generare con: openssl rand -hex 32
CRON_SECRET=

# --- Promemoria dei pasti: Web Push (PWA) - opzionale ---------------------
# Generare la coppia di chiavi con: npx web-push generate-vapid-keys
# La chiave pubblica e' esposta al browser (NEXT_PUBLIC_, incorporata in build).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contatto del mittente: mailto:... oppure https://...
VAPID_SUBJECT=mailto:admin@example.com

# --- Titolare del trattamento (GDPR): mostrati in /privacy e /terms. NON inventarli.
# Obbligatori in produzione: NAME, ADDRESS, EMAIL (o SUPPORT_EMAIL), DATA_REGION, SENTRY_REGION.
# LEGAL_STRICT=1 npm run check:legal fallisce se mancano.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_LEGAL_PEC=
NEXT_PUBLIC_LEGAL_VAT=
NEXT_PUBLIC_LEGAL_DPO=
# Regione Supabase (es. UE - Francoforte) e Sentry (es. UE - Germania)
NEXT_PUBLIC_LEGAL_DATA_REGION=
NEXT_PUBLIC_LEGAL_SENTRY_REGION=

# --- Rate limit per IP (opzionale) ------------------------------------
# Numero di proxy fidati davanti all'app, per leggere l'IP da x-forwarded-for
# (si conta da destra; default 1). Su Vercel e ignorato: si usa
# x-vercel-forwarded-for, impostato dalla piattaforma.
# TRUSTED_PROXY_COUNT=1

# --- Sicurezza: Content-Security-Policy (opzionale) --------------------
# 1 = invia la CSP come Content-Security-Policy-Report-Only (non blocca nulla):
# utile per un rollout sicuro. Default: vuoto (CSP applicata). Usata in src/proxy.ts.
# CSP_REPORT_ONLY=

# --- Promemoria dei pasti: finestra del cron (opzionale) ---------------
# Minuti (1-60, default 45; sopra 60 viene ridotto a 60) entro cui /api/cron/meal-reminders recupera i promemoria
# scaduti. Usata in src/app/api/cron/meal-reminders/route.ts (vedi README).
# MEAL_REMINDERS_WINDOW_MINUTES=45
# Imposta a true solo se /api/cron/meal-reminders e' chiamata ogni ~15 minuti (vercel.pro.json o scheduler
# esterno). Altrimenti le Impostazioni avvisano che i promemoria web sono controllati una volta al giorno.
# NEXT_PUBLIC_FREQUENT_CRON=false

# --- Versione app mostrata nel feedback (opzionale) --------------------
# Default: versione di package.json. Incorporata in build (NEXT_PUBLIC_).
# NEXT_PUBLIC_APP_VERSION=

# --- Sentry: frazione di tracce lato browser (opzionale) ---------------
# 0-1; se assente vale SENTRY_TRACES_SAMPLE_RATE. Usata in src/lib/monitoring/scrub.ts.
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# --- Backup dello Storage (scripts/backup-storage.mjs) - opzionale -----
# Bucket Supabase da salvare, separati da virgola. Default: recipe-images,avatars.
# Richiede anche NEXT_PUBLIC_SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY.
# BACKUP_BUCKETS=recipe-images,avatars

# --- Seed del catalogo (scripts/seed-catalog.ts) - opzionale -----------
# Email dell'utente editoriale proprietario delle ricette del catalogo.
# Default: catalogo@mestolo.invalid. Richiede SUPABASE_SERVICE_ROLE_KEY.
# SEED_EDITORIAL_EMAIL=catalogo@mestolo.invalid

# --- Build mobile (scripts/mobile-prepare.mjs, mobile-version.mjs) -----
# 1 = consente un CAP_SERVER_URL http:// (solo sviluppo locale). Default: solo HTTPS.
# CAP_ALLOW_HTTP=
# 1 = build per gli store: rifiuta URL segnaposto o non HTTPS (impostata dai workflow CI).
# MOBILE_STORE_BUILD=
# Numero di build nativo (versionCode / CURRENT_PROJECT_VERSION). Impostata dai workflow CI
# (run number); in locale si puo' passare come argomento a scripts/mobile-version.mjs.
# MOBILE_BUILD_NUMBER=

# --- Screenshot per gli store (npm run store:screenshots) - opzionale --
# Obbligatorie per lo script: BASE_URL, EMAIL, PASSWORD (account di prova esistente).
# STORE_BASE_URL=
# STORE_EMAIL=
# STORE_PASSWORD=
# Facoltative. Default locali: it-IT,en-US; default piattaforme: tutte; ricetta: la prima della lista.
# STORE_LOCALES=it-IT,en-US
# STORE_PLATFORMS=android,ios-69,ios-65
# STORE_RECIPE_ID=

# --- Test end-to-end (Playwright) - solo sviluppo/CI -------------------
# I test creano utenti e2e-* con la service role (NEXT_PUBLIC_SUPABASE_URL +
# SUPABASE_SERVICE_ROLE_KEY): usare un progetto Supabase di test, non la produzione.
# Se impostata si testa un ambiente gia' in esecuzione, altrimenti Playwright avvia l'app.
# E2E_BASE_URL=
# Porta del server avviato da Playwright (default 3100).
# E2E_PORT=3100
# Prefisso univoco dell'esecuzione (generato automaticamente; di norma non impostarlo).
# E2E_RUN_ID=

# --- Test di database (npm run test:db) - solo sviluppo/CI -------------
# Stringa di connessione Postgres di un database di test (con le migrazioni applicate).
# Lo script scripts/test-db-local.sh la imposta da solo per il Postgres locale.
# TEST_DATABASE_URL=
